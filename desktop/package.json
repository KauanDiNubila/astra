    "release": "tsc && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0"
  },
  "author": "Astra",
  "homepage": "https://astra-app.dev",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
